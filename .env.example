# ── Spotify ────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Add the redirect URI below to the app's "Redirect URIs".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# The source playlist to watch (the long id from the playlist URL/share link).
SPOTIFY_PLAYLIST_ID=

# ── Tidal ──────────────────────────────────────────────────────────────────
# Create an app at https://developer.tidal.com/dashboard
# Add the redirect URI below to the app's allowed redirect URIs.
TIDAL_CLIENT_ID=
# Client secret is optional (only set it if your Tidal app is "confidential").
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI=http://127.0.0.1:8889/callback
# The destination playlist UUID (from the Tidal playlist URL).
TIDAL_PLAYLIST_ID=
# ISO 3166-1 alpha-2 country code used for catalogue lookups.
TIDAL_COUNTRY_CODE=US

# ── YouTube Music (YouTube Data API v3) ─────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Enable the "YouTube Data API v3" for the project, and add the redirect URI
# below as an authorized redirect URI on the OAuth client.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8890/callback
# The destination YouTube/YouTube Music playlist id (the PL... id from the URL).
YOUTUBE_PLAYLIST_ID=
# Max additions per sync pass to stay within the daily API quota (search=100 +
# insert=50 units each; default daily quota is 10,000 units ~= 66 adds/day).
YOUTUBE_MAX_ADDS_PER_RUN=50

# ── Sync behaviour ───────────────────────────────────────────────────────────
# Comma-separated destinations to mirror to. Options: tidal, youtube.
SYNC_TARGETS=tidal,youtube
# node-schedule cron expression. Default: every 2 minutes.
SYNC_CRON=*/2 * * * *
# On the very first run, also copy tracks that already exist in the Spotify
# playlist (true) or only watch for additions from now on (false).
SYNC_EXISTING_ON_FIRST_RUN=true
# Run one sync immediately on startup, before the first scheduled tick.
RUN_ON_STARTUP=true

# ── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
SENTRY_DSN=
